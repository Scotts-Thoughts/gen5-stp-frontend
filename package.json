{
  "name": "gen5-overlay-app",
  "version": "2.3.1",
  "description": "A minimal Electron application",
  "main": "./main.js",
  "build": {
    "appId": "com.stp.layout-app",
    "productName": "gen5-overlay-app",
    "win": {
      "executableName": "gen5-overlay-app",
      "target": "zip",
      "icon": "./icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "./icon.png",
      "category": "public.app-category.utilities"
    },
    "npmRebuild": false
  },
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win --config",
    "build:mac": "electron-builder --mac --config",
    "build:all": "electron-builder --win --mac --config"
  },
  "devDependencies": {
    "electron": "^25.1.1",
    "electron-builder": "^24.4.0"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^1.0.2",
    "node-key-sender": "^1.0.11"
  }
}
